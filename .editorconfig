root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,md,yml,yaml}]
indent_size = 2

[*.{ps1,bat,cmd}]
end_of_line = crlf

[docs/design/original-v2.0-2026-10-29.md]
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false
